[project]
requires = ["nodejs-24"]
project_type = "web"
version = "1.0.0"

[dev]
build = ["sh", "-c", "ELECTRON_SKIP_BINARY_DOWNLOAD=1 PUPPETEER_SKIP_DOWNLOAD=1 pnpm install --ignore-scripts && cd packages/server && ./node_modules/.bin/prisma generate && ./node_modules/.bin/nest build && cd ../desktop && npx vite build"]
run = ["sh", "-c", "bash /workspace/projects/start.sh"]

[deploy]
build = ["sh", "-c", "ELECTRON_SKIP_BINARY_DOWNLOAD=1 PUPPETEER_SKIP_DOWNLOAD=1 pnpm install --ignore-scripts && cd packages/server && pnpm prisma generate && ./node_modules/.bin/nest build && cd ../desktop && npx vite build"]
run = ["sh", "-c", "bash /workspace/projects/start.sh"]