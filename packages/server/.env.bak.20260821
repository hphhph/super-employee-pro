# ============================================================
# AI超级员工系统 - 环境变量配置模板
# ============================================================
# 使用方法：复制此文件为 .env，填入你申请到的 API Key
# 没有申请到的留空即可，系统会自动跳过对应功能
# ============================================================

# ---------- 基础配置 ----------
NODE_ENV=development
PORT=3000
JWT_SECRET=change-this-to-a-random-string
JWT_EXPIRES_IN=7d

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=SuperEmployee@2026
MYSQL_DATABASE=super_employee
DATABASE_URL="mysql://root:SuperEmployee%402026@localhost:3306/super_employee"

# ---------- Redis ----------
REDIS_PASSWORD=SuperEmployee@2026
REDIS_URL="redis://:SuperEmployee@2026@localhost:6379"

# ---------- MinIO 对象存储 ----------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=SuperEmployee@2026
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=SuperEmployee@2026
MINIO_BUCKET=super-employee

# ============================================================
# AI 模型 API Keys
# ============================================================

# ---------- DeepSeek (AI对话核心) ----------
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- Coze 扣子 (智能体) ----------
# 申请地址：https://www.coze.cn/
COZE_API_TOKEN=
COZE_BASE_URL=https://api.coze.cn
COZE_BOT_ID=

# ---------- OpenAI Sora2 (文生视频) ----------
# 申请地址：https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SORA_MODEL=sora-2

# ---------- Google Veo (视频生成) ----------
# 申请地址：https://cloud.google.com/vertex-ai
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
VEO_MODEL=veo-3.0

# ---------- 字节 Seedance (视频生成) ----------
# 申请地址：火山引擎
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---------- 阿里云 TTS (语音合成) ----------
# 申请地址：https://dashscope.aliyun.coms/
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_TTS_MODEL=cosyvoice-v1
ALIYUN_TTS_VOICE=longxiaochun

# ---------- 通义千问 (备用AI) ----------
# 申请地址：https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-max

# ============================================================
# 社交平台 API Keys (官方接口)
# ============================================================

# ---------- 企业微信 ----------
# 申请地址：https://work.weixin.qq.com/
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_ENCODING_AES_KEY=
WECOM_TOKEN=

# ---------- 抖音开放平台 ----------
# 申请地址：https://developer.open-douyin.com/
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
DOUYIN_OPEN_PLATFORM=https://developer.open-douyin.com

# ---------- 小红书开放平台 ----------
# 申请地址：https://open.xiaohongshu.com/
XIAOHONGSHU_APP_ID=
XIAOHONGSHU_APP_SECRET=

# ---------- 快手开放平台 ----------
# 申请地址：https://open.kuaishou.com/
KUAISHOU_APP_ID=
KUAISHOU_APP_SECRET=

# ---------- 视频号 ----------
# 申请地址：https://channels.weixin.qq.com/
WECHAT_CHANNELS_APP_ID=
WECHAT_CHANNELS_APP_SECRET=

# ---------- Boss直聘 ----------
# 注意：Boss直聘无公开API，此处预留Cookie/Token配置
BOSS_COOKIE=
BOSS_USER_AGENT=

# ---------- 智联招聘 ----------
ZHILIAN_COOKIE=
ZHILIAN_USER_AGENT=

# ============================================================
# 其他配置
# ============================================================

# ---------- 前端配置 ----------
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000/ws

# ---------- 文件上传限制 ----------
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,mp4,mov,wav,mp3,pdf,doc,docx,xls,xlsx

# ---------- 算力配额 ----------
DEFAULT_COMPUTE_QUOTA=1000
COMPUTE_COST_CHAT=1
COMPUTE_COST_IMAGE=10
COMPUTE_COST_VIDEO=50
COMPUTE_COST_TTS=5
