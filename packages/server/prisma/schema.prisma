// ============================================================
// 15. AI个微 (个人微信)
// ============================================================

model WxDevice {
  id           Int       @id @default(autoincrement())
  deviceId     String    @unique @db.VarChar(100)
  name         String?   @db.VarChar(100)
  wxId         String?   @db.VarChar(100)
  nickname     String?   @db.VarChar(100)
  avatar       String?   @db.VarChar(500)
  status       Int       @default(0) // 0=离线 1=在线
  lastActiveAt DateTime?
  info         Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  friends      WxFriend[]
  sessions     WxSession[]
  moments      WxMoment[]

  @@map("wx_devices")
}

model WxFriend {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  device    WxDevice @relation(fields: [deviceId], references: [id])
  wxId      String   @db.VarChar(100) // 微信号
  nickname  String?  @db.VarChar(100)
  avatar    String?  @db.VarChar(500)
  remark    String?  @db.VarChar(200) // 备注
  tags      Json?    // 标签
  labels    Json?    // 自定义标签
  source    String?  @db.VarChar(100)
  status    Int      @default(1)
  friendAt  DateTime?
  lastChatAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  WxSession[]
  messages  WxMessage[]

  @@index([deviceId])
  @@map("wx_friends")
}

model WxSession {
  id            Int      @id @default(autoincrement())
  friendId      Int
  friend        WxFriend @relation(fields: [friendId], references: [id])
  deviceId      Int?
  device        WxDevice? @relation(fields: [deviceId], references: [id])
  unreadCount   Int      @default(0)
  lastMessage   String?  @db.VarChar(500)
  lastMessageAt DateTime?
  pinned        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages      WxMessage[]

  @@map("wx_sessions")
}

model WxMessage {
  id        Int      @id @default(autoincrement())
  sessionId Int
  session   WxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  friendId  Int
  friend    WxFriend  @relation(fields: [friendId], references: [id])
  direction String   @default("in") @db.VarChar(10)
  type      String   @db.VarChar(20) // text|image|file|link|video|voice|emoji|miniprogram
  content   String   @db.LongText
  extra     Json?
  isRead    Boolean  @default(false)
  createdBy String   @default("ai") @db.VarChar(20)
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([friendId])
  @@map("wx_messages")
}

model WxMoment {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  device    WxDevice @relation(fields: [deviceId], references: [id])
  content   String   @db.LongText
  images    Json?    // 图片URL列表
  videoUrl  String?  @db.VarChar(500)
  likes     Int      @default(0)
  comments  Json?    // 评论列表
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wx_moments")
}

model WxKeyword {
  id          Int      @id @default(autoincrement())
  keyword     String   @db.VarChar(200)
  replyType   String   @default("text") @db.VarChar(20)
  replyContent String  @db.Text
  matchType   String   @default("exact") @db.VarChar(20)
  priority    Int      @default(0)
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("wx_keywords")
}

model WxBulkTask {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  targetType  String   @db.VarChar(20)
  target      Json?
  contentType String   @default("text") @db.VarChar(20)
  content     String   @db.LongText
  status      String   @default("pending") @db.VarChar(20)
  total       Int      @default(0)
  sent        Int      @default(0)
  failed      Int      @default(0)
  scheduledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("wx_bulk_tasks")
}

model WxSopTask {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  steps       Json
  targetType  String   @db.VarChar(20)
  target      Json?
  trigger     String   @default("add_friend") @db.VarChar(30)
  status      String   @default("active") @db.VarChar(20)
  total       Int      @default(0)
  executed    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("wx_sop_tasks")
}

model WxAutoInteraction {
  id          Int      @id @default(autoincrement())
  type        String   @db.VarChar(20) // like|comment|like_comment
  targetType  String   @db.VarChar(20)
  target      Json?
  commentTemplates Json?
  likeProbability Float @default(0.3)
  commentProbability Float @default(0.2)
  delayMin    Int      @default(5)
  delayMax    Int      @default(30)
  status      String   @default("active") @db.VarChar(20)
  total       Int      @default(0)
  executed    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("wx_auto_interactions")
}

model WxFriendTask {
  id          Int      @id @default(autoincrement())
  type        String   @db.VarChar(30) // auto_greet|auto_add|auto_reply
  name        String   @db.VarChar(200)
  target      Json?
  content     String   @db.LongText
  condition   Json?
  status      String   @default("active") @db.VarChar(20)
  total       Int      @default(0)
  executed    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("wx_friend_tasks")
}
